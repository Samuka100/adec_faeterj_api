NODE_ENV=development
TZ=America/Sao_Paulo

#APP
APP_NAME=

#LOG (fatal|error|warn|info|debug|trace|silent) - padrão: debug local, info em produção
LOG_LEVEL=

#PORTA
PORT=

#DATABASE (MongoDB Atlas)
CONNECTSTRING=

#AUTH (JWT) - segredo longo e aleatório; TOKEN_EXPIRATION aceita 15m, 2h, 1d...
ACCESS_TOKEN_SECRET=
TOKEN_EXPIRATION=1d

#DOCKER CONTAINER
CONTAINER_NAME=